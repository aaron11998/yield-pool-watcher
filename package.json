{
  "name": "yield-pool-watcher",
  "version": "0.1.0",
  "private": true,
  "description": "Top-100 DeFi yield pool monitor (Aave V3, Uniswap V3 on Ethereum) — APY/TVL deltas, threshold alerts, x402 pay-per-call API on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "js-sha3": "^0.13.0",
    "x402-hono": "^1.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.133.0"
  }
}
